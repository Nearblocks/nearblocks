{
  "name": "nearblocks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "format": "oxfmt && prettier --write 'apps/**/*.sql'",
    "format:check": "oxfmt --check && prettier --check 'apps/**/*.sql'",
    "prepare": "husky",
    "test": "turbo run test"
  },
  "dependencies": {},
  "devDependencies": {
    "eslint-plugin-perfectionist": "^5.12.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "prettier": "3.9.9",
    "prettier-plugin-sql": "0.20.0",
    "turbo": "^2.11.6",
    "wrangler": "^3.86.0"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  }
}
