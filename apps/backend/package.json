{
  "name": "backend",
  "version": "0.1.0",
  "author": "NearBlocks",
  "license": "Business Source License 1.1",
  "type": "module",
  "imports": {
    "#*": [
      "./dist/*.js"
    ]
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc",
    "start": "node dist/index.js",
    "watch": "tsc -w",
    "dev": "concurrently 'pnpm watch' 'node --watch --watch-path=./dist --env-file=.env dist/index.js'",
    "lint": "tsc --noEmit && oxlint -c ../../.oxlintrc.json --fix .",
    "lint:check": "tsc --noEmit && oxlint -c ../../.oxlintrc.json ."
  },
  "dependencies": {
    "@near-js/jsonrpc-client": "catalog:",
    "@near-js/jsonrpc-types": "catalog:",
    "@sentry/node": "catalog:",
    "axios": "catalog:",
    "big.js": "7.0.1",
    "dayjs": "catalog:",
    "envalid": "catalog:",
    "es-toolkit": "catalog:",
    "ethers": "catalog:",
    "node-cron": "4.6.0"
  },
  "devDependencies": {
    "@types/big.js": "catalog:",
    "@types/node": "catalog:",
    "concurrently": "~9.2.1",
    "knex": "catalog:",
    "nb-knex": "workspace:*",
    "nb-logger": "workspace:*",
    "nb-near": "workspace:*",
    "nb-tsconfig": "workspace:*",
    "nb-types": "workspace:*",
    "nb-utils": "workspace:*",
    "rimraf": "~6.0",
    "typescript": "catalog:"
  }
}
