# block-proxy environment configuration
#
# Every setting has a safe default: with none set this is a neardata-only
# proxy. Sources are chosen only by BLOCK_SOURCES (see README).

# --- Core ---
# PORT=3000
# ADMIN_PORT=3001
# LISTEN_HOST=0.0.0.0
# ADMIN_LISTEN_HOST=0.0.0.0
# NETWORK=mainnet
# LOG_LEVEL=info
# PROXY_API_KEY=

# --- Sources, in priority order: node, proxy, neardata ---
# BLOCK_SOURCES=neardata
# UPSTREAM_TIMEOUT_SECS=10

# neardata
# NEARDATA_URL=https://mainnet.neardata.xyz
# NEARDATA_UPSTREAM_API_KEY=

# proxy (another block-proxy, e.g. the one next to the node)
# BLOCK_PROXY_UPSTREAM_URL=
# BLOCK_PROXY_UPSTREAM_API_KEY=

# node
# NODE_RPC_URL=http://127.0.0.1:3030
# INDEXER_STATE_DIR=/app/state

# --- Cache ---
# CACHE_ENABLED=true
# CACHE_DIR=/app/cache
# CACHE_TTL_SECS=3600

# --- Shadow comparison (off by default) ---
# Re-fetch served near-tip blocks from this source and compare (see README).
# SHADOW_SOURCE=proxy
# SHADOW_SAMPLE_RATE=1
