# block-proxy environment configuration
#
# All variables have safe defaults. Zero config = fastnear-only proxy.
# Enable S3 by setting its _ENABLED flag and credentials.

# --- Core ---
# PORT=3000
# ADMIN_PORT=3001
# NETWORK=mainnet
# LOG_LEVEL=info

# --- Cache ---
# CACHE_ENABLED=true
# CACHE_DIR=/app/cache
# CACHE_TTL_SECS=3600

# --- Dedup ---
# Hard ceiling on how long one in-flight fetch may hold its dedup entry.
# Range 5-60.
# DEDUP_TTL_SECS=25

# --- neardata upstreams ---
# FASTNEAR_ENABLED gates the whole pool. Set it false only when S3 is configured.
# FASTNEAR_ENABLED=true
#
# Single upstream (the default): derived from NETWORK, or overridden here.
# FASTNEAR_URL=https://mainnet.neardata.xyz
# FASTNEAR_API_KEY=
#
# Multiple upstreams: a JSON array, tried in list order, for redundancy when a
# single endpoint is unavailable or degraded. Each entry is any
# neardata-compatible endpoint. Overrides FASTNEAR_URL / FASTNEAR_API_KEY.
# NEARDATA_UPSTREAMS='[{"name":"secondary","url":"http://10.0.0.11:3000"},{"name":"primary","url":"https://mainnet.neardata.xyz","apiKey":"..."}]'
#
# An endpoint reporting 429/503 is rested and the next is tried. The delay
# doubles per consecutive limit - base, 2x, 4x ... capped at max. A success
# clears it.
# NEARDATA_COOLDOWN_BASE_SECS=60
# NEARDATA_COOLDOWN_MAX_SECS=900

# --- S3/MinIO (disabled by default, set these if you have a local block store) ---
# S3_ENABLED=false
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=blocks
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# UPSTREAM_TIMEOUT_SECS=10
