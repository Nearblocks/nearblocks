{
  "singleQuote": true,
  "trailingComma": "all",
  "overrides": [
    {
      "files": ["*.sql"],
      "options": {
        "formatter": "sql-formatter",
        "language": "postgresql",
        "paramTypes": "{ \"custom\": [ { \"regex\": \"\\\\$\\\\{[^}]+\\\\}\" } ] }"
      }
    }
  ],
  "plugins": ["prettier-plugin-sql"],
  "language": "postgresql",
  "dataTypeCase": "upper",
  "functionCase": "upper"
}
